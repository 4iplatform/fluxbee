{
  "wf_schema_version": "1",
  "workflow_type": "router",
  "description": "Ingress host/specialist router (v0.0.7). Started by a person's message from one of the two IO nodes written here, IO.wapp.acme@motherbee or IO.api.support@motherbee: keeps the message and the IO node that sent it (event.src), forwards the message as it came to a HOST AI, escalates it to a SPECIALIST AI when the host answers ROUTE_SPECIALIST, and forwards the final answer as it came to the IO node the question came from, one transition per IO node; the answer keeps the message's reply context (context.io), so that node delivers it to the customer. A person's further message while an agent answers is kept, as the question, and goes to that agent. An agent's error answer is a payload of type error, and a turn not answered in 120 s fails on its timer (event.timer_key).",
  "start_from": ["IO.wapp.acme@motherbee", "IO.api.support@motherbee"],
  "input_schema": {
    "type": "object",
    "properties": {
      "content": { "type": "string", "minLength": 1 }
    },
    "required": ["content"]
  },
  "initial_state": "asking_host",
  "terminal_states": ["answered", "failed"],
  "states": [
    {
      "name": "asking_host",
      "description": "Keep the question and the IO node that sent it, forward the question to the HOST AI, and await its triage decision. A further message from the person is kept as the question and goes to the host too.",
      "entry_actions": [
        { "type": "keep_message", "name": "question" },
        { "type": "set_variable", "name": "origin", "value": "event.src" },
        { "type": "forward", "target": "AI.host@motherbee" },
        { "type": "schedule_timer", "timer_key": "host_timeout", "fire_in": "120s", "missed_policy": "fire" }
      ],
      "exit_actions": [ { "type": "cancel_timer", "timer_key": "host_timeout" } ],
      "transitions": [
        {
          "event_match": { "src": "AI.host@motherbee" },
          "guard": "event.payload.type == 'error'",
          "target_state": "failed",
          "actions": [ { "type": "set_variable", "name": "failure_reason", "value": "'host_error:' + event.payload.code" } ]
        },
        {
          "event_match": { "src": "AI.host@motherbee" },
          "guard": "event.payload.type == 'text' && event.payload.content.contains('ROUTE_SPECIALIST')",
          "target_state": "asking_specialist",
          "actions": []
        },
        {
          "event_match": { "src": "AI.host@motherbee" },
          "guard": "event.payload.type == 'text'",
          "target_state": "replying",
          "actions": [
            { "type": "keep_message", "name": "answer" },
            { "type": "set_variable", "name": "answered_by", "value": "'host'" }
          ]
        },
        {
          "event_match": { "src": "IO.wapp.acme@motherbee" },
          "guard": "true",
          "actions": [
            { "type": "keep_message", "name": "question" },
            { "type": "forward", "target": "AI.host@motherbee", "message": "question" }
          ]
        },
        {
          "event_match": { "src": "IO.api.support@motherbee" },
          "guard": "true",
          "actions": [
            { "type": "keep_message", "name": "question" },
            { "type": "forward", "target": "AI.host@motherbee", "message": "question" }
          ]
        },
        {
          "event_match": { "msg": "TIMER_FIRED" },
          "guard": "event.timer_key == 'host_timeout'",
          "target_state": "failed",
          "actions": [ { "type": "set_variable", "name": "failure_reason", "value": "'host_timeout'" } ]
        }
      ]
    },
    {
      "name": "asking_specialist",
      "description": "The host escalated (ROUTE_SPECIALIST): forward the question, as it came, to the SPECIALIST AI and await its answer. A further message from the person is kept as the question and goes to the specialist too.",
      "entry_actions": [
        { "type": "forward", "target": "AI.specialist@motherbee", "message": "question" },
        { "type": "schedule_timer", "timer_key": "specialist_timeout", "fire_in": "120s", "missed_policy": "fire" }
      ],
      "exit_actions": [ { "type": "cancel_timer", "timer_key": "specialist_timeout" } ],
      "transitions": [
        {
          "event_match": { "src": "AI.specialist@motherbee" },
          "guard": "event.payload.type == 'error'",
          "target_state": "failed",
          "actions": [ { "type": "set_variable", "name": "failure_reason", "value": "'specialist_error:' + event.payload.code" } ]
        },
        {
          "event_match": { "src": "AI.specialist@motherbee" },
          "guard": "event.payload.type == 'text'",
          "target_state": "replying",
          "actions": [
            { "type": "keep_message", "name": "answer" },
            { "type": "set_variable", "name": "answered_by", "value": "'specialist'" }
          ]
        },
        {
          "event_match": { "src": "IO.wapp.acme@motherbee" },
          "guard": "true",
          "actions": [
            { "type": "keep_message", "name": "question" },
            { "type": "forward", "target": "AI.specialist@motherbee", "message": "question" }
          ]
        },
        {
          "event_match": { "src": "IO.api.support@motherbee" },
          "guard": "true",
          "actions": [
            { "type": "keep_message", "name": "question" },
            { "type": "forward", "target": "AI.specialist@motherbee", "message": "question" }
          ]
        },
        {
          "event_match": { "msg": "TIMER_FIRED" },
          "guard": "event.timer_key == 'specialist_timeout'",
          "target_state": "failed",
          "actions": [ { "type": "set_variable", "name": "failure_reason", "value": "'specialist_timeout'" } ]
        }
      ]
    },
    {
      "name": "replying",
      "description": "The answer is kept. One transition per IO node written here forwards it, as it came, to the one the question came from.",
      "entry_actions": [ { "type": "emit_internal_event", "meta": { "msg": "REPLY" } } ],
      "exit_actions": [],
      "transitions": [
        {
          "event_match": { "msg": "REPLY" },
          "guard": "state.origin == 'IO.wapp.acme@motherbee'",
          "target_state": "answered",
          "actions": [ { "type": "forward", "target": "IO.wapp.acme@motherbee", "message": "answer" } ]
        },
        {
          "event_match": { "msg": "REPLY" },
          "guard": "state.origin == 'IO.api.support@motherbee'",
          "target_state": "answered",
          "actions": [ { "type": "forward", "target": "IO.api.support@motherbee", "message": "answer" } ]
        }
      ]
    },
    {
      "name": "answered",
      "description": "The answer went back to the IO node the question came from.",
      "entry_actions": [],
      "exit_actions": [],
      "transitions": []
    },
    {
      "name": "failed",
      "description": "A turn errored or timed out.",
      "entry_actions": [],
      "exit_actions": [],
      "transitions": []
    }
  ]
}
