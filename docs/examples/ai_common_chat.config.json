{
  "behavior": {
    "kind": "ai_chat",
    "model": "gpt-5.5",
    "instructions": {
      "source": "inline",
      "value": "Respond briefly and clearly in Spanish.",
      "trim": true
    }
  },
  "runtime": {
    "read_timeout_ms": 3600000,
    "handler_timeout_ms": 120000,
    "write_timeout_ms": 15000,
    "queue_capacity": 128,
    "worker_pool_size": 4,
    "retry_max_attempts": 3,
    "retry_initial_backoff_ms": 200,
    "retry_max_backoff_ms": 2000,
    "metrics_log_interval_ms": 30000,
    "immediate_memory": {
      "enabled": true,
      "recent_interactions_max": 10,
      "active_operations_max": 8,
      "summary_max_chars": 1600,
      "summary_refresh_every_turns": 3,
      "trim_noise_enabled": true
    }
  }
}
