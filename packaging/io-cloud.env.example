# Fluxbee Cloud service endpoint. Copy to /etc/fluxbee/io-cloud.env on motherbee.
# IO_CLOUD_SECRET is the shared service bearer configured in the Fluxbee Cloud backend.
IO_CLOUD_EDGE_NODE=SY.edge@ingress1
IO_CLOUD_SECRET=replace-with-a-long-random-service-token
IO_CLOUD_ADMIN_HIVE=motherbee
IO_CLOUD_IDENTITY_HIVE=motherbee
IO_CLOUD_INBOUND_FAMILY=user
