#!/usr/bin/env python3
"""fluxbee-factory-reset -- remove what USERS created and leave the hive as fluxbee-firstboot left it.

    sudo fluxbee-factory-reset                                 # DRY-RUN: lists what it would remove
    sudo fluxbee-factory-reset --yes                           # executes; asks you to type the hive_id
    sudo fluxbee-factory-reset --yes --confirm-hive motherbee  # executes, non-interactive

Runs on the MOTHERBEE and covers the whole hive: user nodes on the spokes are killed through
their own orchestrator (kill_node is forwarded), identity deletes replicate as deltas.

REMOVED (operator decisions, 2026-09-28):
  - workflows, on every hive that runs SY.wf-rules: wf_rules_delete with force (a workflow is not
    a normal node -- the rule is the source of truth; this removes the rule, the WF node, its
    state and its packages, running instances included);
  - nodes launched by users, on every hive: kill_node + purge_instance, which also deletes the
    node's ILK, its dedicated vault secrets and its timers;
  - every published page that is up (a /public/<key> link), once no workflow or user node is left
    to publish one: SY.admin lists them (GET /artifacts, each by its publication_id, never by its
    link's key) and takes each down (unpublish_artifact): the edge stops serving it and IO.blob
    releases its copy in blob/public/. When SY.admin cannot list them the reset goes on, and names
    the pages that stay public from SY.admin's ledger, read only (FINDINGS A-212);
  - the remaining user ILKs (humans/agents/temporaries created by messages or by Cloud), and
    every tenant but the root -- PURGED: identity's delete only marks (reversible, keys reserved),
    so the reset marks and then purges; ilks/tenants some earlier delete left marked go too;
  - the message log: every table of the fluxbee_storage DB (turns, inbox, usage...)
    + SY.cognition's state on every hive that runs it, this one included, through
    cognition_clear (its file, its memory and its memory region, the node running) + the
    conversation state of the
    base AI nodes and of the frontdesk (thread-state/, immediate-memory/) + the Architect chat
    sessions;
  - every vault secret except infrastructure (INFRA_KEYS / INFRA_PREFIXES below) -- including
    AI provider keys: the hive ends up as freshly installed, AI degraded until they are reloaded;
  - the user OPA policy on every hive (opa_clear: current, staged, backup; routers unload it --
    the SYSTEM policy is baked into the router and untouched).

KEPT: the installation (package, /etc/fluxbee, vault master key, TLS, mesh and spokes), what
starts as SYSTEM (SY.* nodes and ILKs, the base nodes of base-nodes.json with their ILK, ICH and
config -- e.g. the Cloud door stays published), routes/VPNs/taps and the operational history
(admin command log, deploy history, vault audit, SY.admin's publication ledger, whose rows say
how each page went down). The spokes' host rules are part of the
installation too: the ingress' SSH table (inet fluxbee_ingress) and the egress' table live on
those hosts, which this script never reaches, and their orchestrators apply them again on every
reconcile; remove_hive drops them with the hive (docs/control-path-hardening-v1.md §6).

NOT covered (never touched): the blob store. The blobs nodes wrote stay (blob/active/,
blob/staging/); only a page's copy in blob/public/ goes, with its page.

Everything goes through the product's own admin API except the message log,
which has no API: its tables are truncated with the storage consumers stopped.
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ADMIN = os.environ.get("FLUXBEE_ADMIN", "127.0.0.1:8080")
ARCHITECT = os.environ.get("FLUXBEE_ARCHITECT", "127.0.0.1:3000")
STATE_DIR = os.environ.get("FLUXBEE_STATE_DIR", "/var/lib/fluxbee")
HIVE_YAML = os.environ.get("FLUXBEE_HIVE_YAML", "/etc/fluxbee/hive.yaml")
MANIFEST = os.environ.get("FLUXBEE_BASE_NODES", "/usr/share/fluxbee/base-nodes.json")
STORAGE_DB = "fluxbee_storage"
LOG_PATH = os.path.join(STATE_DIR, "state", "factory-reset.log")
# SY.admin's publication ledger: read only, and only to name the pages that stay public when
# SY.admin cannot list them. Each row holds its link's key, which is never printed.
PUBLICATION_LEDGER = os.path.join(STATE_DIR, "state", "sy-admin", "publications.json")
PAGE_DOWN = ("unpublished", "expired")

# Vault infrastructure that survives: edge bearers and edge TLS (two of fluxbee_sdk's
# CLOUD_RESERVED_VAULT_KEY_PREFIXES), and the postgres secret fluxbee-firstboot writes. The third
# reserved prefix, `ssh:`, held per-spoke SSH recovery keys until D32 removed that mode: nothing
# writes it now, so a leftover is removed like user data. Anything else -- AI keys included -- is
# user data.
INFRA_PREFIXES = ("edge_channel_secret:", "edge_tls", "acme_account")
INFRA_KEYS = ("storage_postgres_url",)
SYSTEM_NODE_PREFIXES = ("SY.", "RT.")
WF_NODE_PREFIX = "WF."
WF_HIVE_ROLES = ("motherbee", "worker")  # the roles that run SY.wf-rules (src/release_settings.rs)
COGNITION_HIVE_ROLES = ("motherbee", "worker")  # the roles that run SY.cognition (the same)
CONVERSATION_DIRS = ("thread-state", "immediate-memory")


def die(msg):
    sys.exit("factory-reset: " + msg)


def api(method, path, body=None, host=None, timeout=60):
    """One admin/architect HTTP call. Returns (http_status, parsed_json_or_text)."""
    url = "http://%s%s" % (host or ADMIN, path)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw, status = r.read().decode("utf-8", "replace"), r.status
    except urllib.error.HTTPError as e:
        raw, status = e.read().decode("utf-8", "replace"), e.code
    except (urllib.error.URLError, OSError) as e:
        return 0, "connection error: %s" % e
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw


def payload(resp):
    return resp.get("payload", resp) if isinstance(resp, dict) else {}


def ok(status, resp):
    return 200 <= status < 300 and isinstance(resp, dict) and resp.get("status", "ok") == "ok"


def q(segment):
    return urllib.parse.quote(segment, safe=":@")


def hive_yaml_value(key):
    try:
        for line in open(HIVE_YAML):
            if line.startswith(key + ":"):
                return line.split(":", 1)[1].strip().strip('"')
    except OSError:
        pass
    return None


def base_nodes():
    try:
        m = json.load(open(MANIFEST))
    except (OSError, ValueError) as e:
        die("cannot read the base-node manifest %s (%s) -- refusing to guess what is system" % (MANIFEST, e))
    return {e["instance"] for e in m.get("runtimes", []) if e.get("boot") and e.get("instance")}


def sh(cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode != 0:
        die("%s failed (rc=%s): %s" % (" ".join(cmd), r.returncode, (r.stderr or r.stdout).strip()[:300]))
    return r


def psql(sql):
    r = sh(["runuser", "-u", "postgres", "--", "psql", "-v", "ON_ERROR_STOP=1", "-d", STORAGE_DB,
            "-At", "-c", sql], check=False)
    if r.returncode != 0:
        die("psql on %s failed: %s" % (STORAGE_DB, (r.stderr or r.stdout).strip()[:300]))
    return [line for line in r.stdout.splitlines() if line.strip()]


# ---------------------------------------------------------------- inventory

def hives_raw():
    status, resp = api("GET", "/hives")
    if not ok(status, resp):
        die("GET /hives failed (%s): %s" % (status, str(resp)[:200]))
    return payload(resp).get("hives", [])


def list_hives():
    return [(h.get("hive_id") or h.get("name"), h.get("status") or h.get("state")) for h in hives_raw()]


def list_workflows():
    """-> [(hive, workflow_name)] on every hive that runs SY.wf-rules. A workflow is not a normal
    node: the RULE is the source of truth and WF.<workflow>@<hive> is derived from it, so it is
    removed through wf_rules_delete (kills+purges the node, its state and its packages)."""
    out = []
    for h in hives_raw():
        hive = h.get("hive_id") or h.get("name")
        if (h.get("role") or "") not in WF_HIVE_ROLES:
            continue
        status, resp = api("GET", "/hives/%s/wf-rules" % q(hive))
        if not ok(status, resp):
            die("GET /hives/%s/wf-rules failed (%s): %s" % (hive, status, str(resp)[:200]))
        for w in payload(resp).get("workflows", []):
            if w.get("workflow_name"):
                out.append((hive, w["workflow_name"]))
    return out


def list_nodes(hive):
    status, resp = api("GET", "/hives/%s/nodes" % q(hive))
    if not ok(status, resp):
        die("GET /hives/%s/nodes failed (%s): %s" % (hive, status, str(resp)[:200]))
    names = []
    for n in payload(resp).get("nodes", []):
        name = n.get("node_name") or n.get("name") if isinstance(n, dict) else n
        if name:
            names.append(name)
    return sorted(set(names))


def persisted_node_names():
    """Managed instances persisted on THIS box (nodes/<KIND>/<name>/config.json). The inventory
    only lists what is RUNNING: a node that is down right now still owns its ILK and its config
    (the orchestrator's reconcile relaunches it), so it must be seen too."""
    out, root = set(), os.path.join(STATE_DIR, "nodes")
    try:
        kinds = os.listdir(root)
    except OSError:
        return out
    for kind in kinds:
        if kind == "SY":
            continue
        try:
            for name in os.listdir(os.path.join(root, kind)):
                if "@" in name and os.path.isfile(os.path.join(root, kind, name, "config.json")):
                    out.add(name)
        except OSError:
            pass
    return out


def all_node_names(hives):
    names = persisted_node_names()
    for hive, _ in hives:
        names.update(list_nodes(hive))
    return names


def is_system_name(name, base):
    return name.startswith(SYSTEM_NODE_PREFIXES) or name in base


def classify_nodes(hives, base, local_hive, workflows):
    """-> (user_nodes [(hive, name)], surviving node names, workflow_nodes [(hive, name)]).
    WF.<workflow>@<hive> of a listed workflow goes with its workflow (wf_rules_delete), not with
    kill_node; an orphan WF.* node (no workflow behind it) is killed like any user node."""
    wf_names = {"%s%s@%s" % (WF_NODE_PREFIX, wf, hive) for hive, wf in workflows}
    user, surviving, skipped = [], set(base), []
    listed = {hive: list_nodes(hive) for hive, _ in hives}
    # Down-but-persisted user nodes on the motherbee get purged too (kill_node purges inactive
    # targets); otherwise their ILK would be removed and reconcile would relaunch them headless.
    listed.setdefault(local_hive, [])
    listed[local_hive] = sorted(set(listed[local_hive]) | persisted_node_names())
    for hive, names in listed.items():
        for name in names:
            if is_system_name(name, base):
                surviving.add(name)
            elif name in wf_names:
                skipped.append((hive, name))
            else:
                user.append((hive, name))
    return user, surviving, skipped


def list_ilks(hive):
    # include_deleted: a reset also PURGES ilks some earlier normal delete only marked.
    status, resp = api("GET", "/hives/%s/identity/ilks?include_deleted=true" % q(hive))
    if not ok(status, resp):
        die("GET identity/ilks failed (%s): %s" % (status, str(resp)[:200]))
    return payload(resp).get("ilks", [])


def user_ilks(hive, surviving, base):
    """Everything that is not SYSTEM and not the ILK of a node that stays -- marked ones included
    (the reset purges them). System/base node ILKs are protected BY NAME too: a base node that
    happens to be down (not in the inventory) must never lose its identity."""
    out = []
    for i in list_ilks(hive):
        if i.get("ilk_type") == "system":
            continue
        node = i.get("node_name")
        if node and (node in surviving or is_system_name(node, base)):
            continue
        out.append(i)
    return out


def user_secrets(hive):
    status, resp = api("GET", "/hives/%s/vault/secrets" % q(hive))
    if not ok(status, resp):
        die("GET vault/secrets failed (%s): %s" % (status, str(resp)[:200]))
    out = []
    for s in payload(resp).get("secrets", []):
        key = s.get("key", "")
        if key in INFRA_KEYS or key.startswith(INFRA_PREFIXES):
            continue
        out.append(s)
    return out


def storage_tables():
    rows = psql("SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename")
    return [t for t in rows if "schema_migrations" not in t]


def storage_counts(tables):
    if not tables:
        return {}
    sql = " UNION ALL ".join("SELECT '%s', count(*) FROM \"%s\"" % (t, t) for t in tables)
    return {row.split("|")[0]: int(row.split("|")[1]) for row in psql(sql)}


def conversation_dirs():
    found = []
    for root in (os.path.join(STATE_DIR, "nodes"), os.path.join(STATE_DIR, "state")):
        for dirpath, dirnames, _ in os.walk(root):
            if dirpath.count(os.sep) - root.count(os.sep) > 5:
                dirnames[:] = []
                continue
            for d in list(dirnames):
                if d in CONVERSATION_DIRS:
                    found.append(os.path.join(dirpath, d))
                    dirnames.remove(d)
    return sorted(found)


def cognition_hives(local_hive):
    """The hives that run SY.cognition, this one included. Each keeps its state in a file of its
    own (A-158), and SY.admin's cognition_clear has the node drop it, running (FINDINGS A-160): a
    stopped system unit does not stay stopped, SY.orchestrator's watchdog starts it again within
    seconds, so no file is removed by hand under a node that may have opened it again."""
    out = {local_hive}
    for h in hives_raw():
        hive = h.get("hive_id") or h.get("name")
        if hive and (h.get("role") or "") in COGNITION_HIVE_ROLES:
            out.add(hive)
    return sorted(out)


def clear_cognitions(hives):
    """cognition_clear on each hive: its SY.cognition drops every communication and every episode it
    keeps, in memory, in its file and in its memory region, keeps running, and says what it
    removed."""
    failed = []
    for hive in hives:
        status, resp = api("POST", "/hives/%s/cognition/clear" % q(hive), {}, timeout=60)
        good = ok(status, resp)
        print("  %-5s cognition_clear on %s" % ("OK" if good else "FAIL", hive))
        if good:
            removed = payload(resp).get("removed") or {}
            stored, held = removed.get("file") or {}, removed.get("memory") or {}
            print("    its file: %s communications, %s episodes; its memory: %s communications, %s episodes"
                  % (stored.get("communications"), stored.get("episodes"),
                     held.get("communications"), held.get("episodes")))
        else:
            print("    %s %s" % (status, str(resp)[:200]))
            failed.append((hive, status, str(resp)[:200]))
    return failed


def published_pages():
    """-> (pages, None): the public pages that are up, as SY.admin lists them (GET /artifacts,
    list_published_artifacts), each named by its publication_id, never by its link's key; or
    (None, why) when SY.admin does not list them."""
    status, resp = api("GET", "/artifacts")
    if not ok(status, resp):
        return None, "%s %s" % (status, str(resp)[:200])
    return payload(resp).get("publications", []), None


def ledger_pages():
    """The pages SY.admin's ledger holds as up (neither unpublished nor expired, and not past
    their expires_at), newest first: what stays public when SY.admin cannot take them down. None
    when the ledger cannot be read; none at all without one."""
    try:
        with open(PUBLICATION_LEDGER) as f:
            ledger = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError):
        return None
    rows = ledger.get("publications") if isinstance(ledger, dict) else None
    now = time.time()
    up = [p for p in (rows.values() if isinstance(rows, dict) else [])
          if isinstance(p, dict) and p.get("status") not in PAGE_DOWN
          and isinstance(p.get("expires_at"), (int, float)) and p["expires_at"] > now]
    return sorted(up, key=lambda p: -(p.get("created_at") or 0))


def page_line(page):
    """One page, by the fields an operator reads (a row of the list or of the ledger), never by
    its link's key."""
    name = page.get("filename_original") or (page.get("blob_ref") or {}).get("filename_original")
    try:
        expires = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(int(page.get("expires_at"))))
    except (TypeError, ValueError, OverflowError, OSError):
        expires = "?"
    return "%s  %-14s %-24s %s  %s  expires %s" % (
        page.get("publication_id"), page.get("status") or "?", name or "?",
        page.get("tenant_id") or "?", page.get("publisher_l2_name") or "?", expires)


def print_ledger_pages(indent):
    """What SY.admin's ledger holds as up, when SY.admin does not list the pages: they stay
    public until they expire (30 days at most) or are unpublished."""
    left = ledger_pages()
    if left is None:
        print("%sSY.admin's ledger (%s) cannot be read either: pages may stay public until they"
              " expire (30 days at most)" % (indent, PUBLICATION_LEDGER))
        return
    print("%s%d stay public until they expire (30 days at most) or are unpublished, by SY.admin's"
          " ledger (%s):" % (indent, len(left), PUBLICATION_LEDGER))
    for p in left:
        print("%s  %s" % (indent, page_line(p)))


ROOT_TENANT = "tnt:00000000-0000-0000-0000-000000000001"


def opa_user_policy_versions():
    """{hive: current user-policy version} (0 = none), asked hive by hive. SY.opa.rules runs on
    EVERY hive: the motherbee compiles the one global policy and the others install it from the
    synced dist/policy folder (logbook 2026-09-30)."""
    found = {}
    for h in hives_raw():
        hive = h.get("hive_id") or h.get("name")
        status, resp = api("GET", "/hives/%s/opa/status" % q(hive))
        for entry in (resp.get("responses") or []) if isinstance(resp, dict) else []:
            inner = entry.get("payload") or {}
            if entry.get("hive") == hive and "current_version" in inner:
                found[hive] = inner.get("current_version") or 0
    return found


def user_tenants(hive):
    status, resp = api("GET", "/hives/%s/identity/tenants?include_deleted=true" % q(hive))
    if not ok(status, resp):
        die("GET identity/tenants failed (%s): %s" % (status, str(resp)[:200]))
    return [t for t in payload(resp).get("tenants", []) if t.get("tenant_id") != ROOT_TENANT]


def purge_identity(kind, hive, record):
    """The identity model (2026-09-28): delete only MARKS; purge is physical and needs the mark.
    A reset does both. Marking is idempotent (already_deleted), so it is always sent first."""
    base = "/hives/%s/identity/%s/%s" % (q(hive), kind, q(record))
    status, resp = api("DELETE", base)
    if not ok(status, resp):
        return status, resp
    return api("POST", base + "/purge", {})


# ---------------------------------------------------------------- actions

def rm_path(path):
    if os.path.isdir(path) and not os.path.islink(path):
        sh(["rm", "-rf", "--one-file-system", path])
    elif os.path.lexists(path):
        os.remove(path)


def kill_user_nodes(nodes):
    failed = []
    for hive, name in nodes:
        status, resp = api("DELETE", "/hives/%s/nodes/%s" % (q(hive), q(name)),
                           {"force": False, "purge_instance": True}, timeout=120)
        good = ok(status, resp)
        print("  %-5s kill+purge %s (on %s)" % ("OK" if good else "FAIL", name, hive))
        if not good:
            failed.append((name, status, str(resp)[:200]))
    return failed


def unpublish_pages():
    """Take every page that is up down through SY.admin: unpublish_artifact by its publication_id,
    list after list while a pass takes one down, so a page published meanwhile goes too and a
    failure is retried. A page already down answers ok as well. When SY.admin does not list them,
    the reset goes on: it says so and names the pages that stay public from SY.admin's ledger.
    -> (pages taken down, failures [(what, why)])."""
    done, failed = 0, {}
    for _ in range(10):
        pages, why = published_pages()
        if pages is None:
            print("  FAIL SY.admin did not list the published pages: %s" % why)
            print_ledger_pages("    ")
            return done, [("published pages", why)] + list(failed.items())
        failed = {}
        if not pages:
            break
        progress = 0
        for p in pages:
            pid = p.get("publication_id")
            # The publication lock a publish in flight holds (up to 110 s), then the edge and
            # IO.blob (30 s each).
            status, resp = api("POST", "/artifacts/unpublish", {"publication_id": pid}, timeout=180)
            if ok(status, resp):
                done += 1
                progress += 1
            else:
                failed[pid] = "%s %s" % (status, str(resp)[:160])
        if not progress:
            break
    print("  pages: %d taken down, %d failed" % (done, len(failed)))
    for pid, why in failed.items():
        print("    FAIL %s: %s" % (pid, why))
    return done, list(failed.items())


def delete_until_empty(label, lister, deleter, ident):
    """Delete, re-list, repeat. Lists are paged (vault: 200), a pass may race a late write, and
    some deletes depend on others (a sponsor tenant goes only after its sponsored ones): failures
    are RETRIED while a pass makes progress; it stops when a whole pass deletes nothing."""
    done, failed = 0, {}
    for _ in range(10):
        pending = lister()
        failed = {}
        if not pending:
            break
        progress = 0
        for item in pending:
            status, resp = deleter(item)
            if ok(status, resp):
                done += 1
                progress += 1
            else:
                failed[ident(item)] = "%s %s" % (status, str(resp)[:160])
        if not progress:
            break
    print("  %s: %d deleted, %d failed" % (label, done, len(failed)))
    for k, why in failed.items():
        print("    FAIL %s: %s" % (k, why))
    return failed


def hold_down(units):
    """Stop these system units and keep them down until `release`: SY.orchestrator's watchdog
    starts an inactive system unit again within seconds, so each is masked for this boot first.
    A reset killed before `release` leaves them masked until the next boot."""
    units = [u for u in units if sh(["systemctl", "cat", u], check=False).returncode == 0]
    if units:
        sh(["systemctl", "mask", "--runtime"] + units)
        sh(["systemctl", "stop"] + units)
    return units


def release(units):
    if units:
        sh(["systemctl", "unmask", "--runtime"] + units, check=False)
        sh(["systemctl", "start"] + units)


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--yes", action="store_true", help="execute (default is a dry-run)")
    ap.add_argument("--confirm-hive", help="hive_id, to skip the interactive confirmation")
    a = ap.parse_args()

    execute = a.yes
    if execute and os.geteuid() != 0:
        die("run it as root (sudo) -- it stops units, truncates the message DB and removes state")
    if hive_yaml_value("role") != "motherbee":
        die("this is not a motherbee (%s: role=%s) -- run it on the motherbee" % (HIVE_YAML, hive_yaml_value("role")))
    hive_id = hive_yaml_value("hive_id") or "motherbee"
    base = base_nodes()

    hives = list_hives()
    not_ready = [h for h, st in hives if st not in ("alive", "connected")]
    if not_ready:
        die("hives not alive/connected: %s -- a reset needs every hive up (spoke nodes are killed there)"
            % ", ".join("%s=%s" % (h, st) for h, st in hives if h in not_ready))

    workflows = list_workflows()
    user_nodes, surviving, wf_nodes = classify_nodes(hives, base, hive_id, workflows)
    # The listing counts the ILKs that go on their own (not those of the nodes removed in [0]/[1]).
    going = {name for _, name in user_nodes} | {name for _, name in wf_nodes}
    pages_now, pages_why = published_pages()
    ilks_now = user_ilks(hive_id, surviving | going, base)
    secrets_now = user_secrets(hive_id)
    can_db = os.geteuid() == 0
    tables = storage_tables() if can_db else []
    counts = storage_counts(tables) if can_db else {}
    conv = conversation_dirs()
    cog_hives = cognition_hives(hive_id)
    tenants = user_tenants(hive_id)
    opa_versions = opa_user_policy_versions()

    print("fluxbee-factory-reset -- hive %s (%s)" % (hive_id, "EXECUTE" if execute else "DRY-RUN"))
    print("hives: %s" % ", ".join("%s=%s" % h for h in hives))
    print("\n[0] workflows to delete (wf_rules_delete force: rule, WF node, state, packages): %d" % len(workflows))
    for hive, wf in workflows:
        print("    %s  (on %s)" % (wf, hive))
    print("[1] user nodes to kill+purge (ILK, node secrets and timers go with them): %d" % len(user_nodes))
    for hive, name in user_nodes:
        print("    %s  (on %s)" % (name, hive))
    if pages_now is None:
        print("[2] published pages: SY.admin did not list them (%s)" % pages_why)
        print_ledger_pages("    ")
    else:
        print("[2] published pages to take down through SY.admin (unpublish_artifact; each one's copy"
              " in blob/public/ goes with it): %d" % len(pages_now))
        for p in pages_now:
            print("    %s" % page_line(p))
    print("[3] user ILKs to purge (mark + purge; already-marked ones too): %d  (plus the ILKs of the nodes above)" % len(ilks_now))
    for i in ilks_now:
        print("    %s  %-8s %s%s" % (i.get("ilk_id"), i.get("ilk_type"), i.get("display_name") or i.get("node_name") or "",
                                   "  [already marked]" if i.get("deleted_at_ms") else ""))
    print("[4] vault secrets to delete (everything but infra): %d" % len(secrets_now))
    for s in secrets_now:
        md = s.get("metadata") or {}
        print("    %-40s %s" % (s.get("key"), md.get("resource_type") or ""))
    print("[5] tenants to purge (all but the root; mark + purge): %d" % len(tenants))
    for t in tenants:
        print("    %s  %s%s" % (t.get("tenant_id"), t.get("name") or "", "  [already marked]" if t.get("deleted_at_ms") else ""))
    print("[6] user OPA policy -- opa_clear on every hive (current, staged, backup; routers unload it): %s"
          % (", ".join("%s=v%s" % kv for kv in sorted(opa_versions.items())) or "status unavailable"))
    if can_db:
        print("[7] message log (%s), rows per table -- all truncated:" % STORAGE_DB)
        for t in tables:
            print("    %-36s %d" % (t, counts.get(t, 0)))
    else:
        print("[7] message log (%s): run as root to see the row counts" % STORAGE_DB)
    print("    + SY.cognition on every hive that runs it (cognition_clear: its file, its memory and its memory region): %s"
          % (", ".join(cog_hives) or "none"))
    print("    + conversation state of the nodes that stay: %d dirs" % len(conv))
    for d in conv:
        print("      %s" % d)
    print("    + Architect chat sessions (DELETE /api/sessions)")
    print("\nNOT touched: routes/VPNs/taps, history, the blob store (but the pages' copies in blob/public/),"
          " system + base nodes (%s)." % ", ".join(sorted(base)))

    if not execute:
        print("\nDRY-RUN: nothing was changed. Execute with --yes.")
        return 0

    confirm = a.confirm_hive
    if confirm is None:
        confirm = input("\nThis REMOVES the data above and cannot be undone. Type the hive_id (%s) to go on: " % hive_id).strip()
    if confirm != hive_id:
        die("confirmation does not match the hive_id -- nothing changed")

    t0 = time.time()
    print("\n== [0/8] delete workflows")
    wf_fail = []
    for hive, wf in workflows:
        status, resp = api("POST", "/hives/%s/wf-rules/delete" % q(hive),
                           {"workflow_name": wf, "force": True}, timeout=180)
        good = ok(status, resp)
        print("  %-5s %s (on %s)" % ("OK" if good else "FAIL", wf, hive))
        if not good:
            wf_fail.append((wf, status, str(resp)[:200]))
            print("    %s %s" % (status, str(resp)[:200]))
    print("== [1/8] kill+purge user nodes")
    node_fail = kill_user_nodes(user_nodes)

    print("== [2/8] take down the published pages")
    # After [0] and [1], so no workflow or user node is left to publish a page meanwhile, and
    # while SY.admin, the edge and IO.blob run: nothing the reset stops serves the take-down.
    pages_done, page_fail = unpublish_pages()

    print("== [3/8] purge user ILKs")
    # Keep the ILK of EVERY node still alive -- a kill that failed must not lose its identity.
    surviving_now = all_node_names(list_hives())
    ilk_fail = delete_until_empty(
        "ILKs (mark + purge)", lambda: user_ilks(hive_id, surviving_now, base),
        lambda i: purge_identity("ilks", hive_id, i["ilk_id"]),
        lambda i: i["ilk_id"])

    print("== [4/8] delete user vault secrets")
    # Each key is deleted in the tenant it belongs to: SY.vault answers KEY_NOT_FOUND for a key
    # named in another tenant, and admin fills in the root tenant when none is named.
    vault_fail = delete_until_empty(
        "secrets", lambda: user_secrets(hive_id),
        lambda s: api("DELETE", "/hives/%s/vault/secrets/%s?tenant_id=%s" % (
            q(hive_id), q(s["key"]), q((s.get("metadata") or {}).get("tenant_id", "")))),
        lambda s: s["key"])

    print("== [5/8] delete tenants (all but the root)")
    # Passes: a sponsor can only be marked/purged once its sponsored tenants are gone, so the
    # children fall on the first pass and their sponsors on the next.
    tenant_fail = delete_until_empty(
        "tenants (mark + purge)", lambda: user_tenants(hive_id),
        lambda t: purge_identity("tenants", hive_id, t["tenant_id"]),
        lambda t: t["tenant_id"])

    print("== [6/8] clear the user OPA policy (every hive)")
    api("POST", "/opa/policy/clear", {}, timeout=120)
    # Judge by the RESULT, asked hive by hive. The motherbee clears at once; the other hives clear
    # when the published (empty) policy reaches them by Syncthing, so give them a moment.
    deadline = time.time() + 60
    while True:
        left_opa = {h: v for h, v in opa_user_policy_versions().items() if v}
        if not left_opa or time.time() >= deadline:
            break
        time.sleep(5)
    opa_fail = [("opa", h, v) for h, v in sorted(left_opa.items())]
    print("  %s" % ("no user policy left on any hive" if not opa_fail
                    else "FAIL user policy still loaded: %s" % left_opa))
    print("== [7/8] message log")
    # Every hive's SY.cognition drops what it keeps through cognition_clear, running, this one's
    # included (`cognition_hives`). No episode can be made meanwhile: the AI keys went at [4].
    cog_fail = clear_cognitions(cog_hives)
    # SY.* are real systemd units, held down for the truncate (`hold_down`). The base AI nodes are
    # orchestrator-managed TRANSIENT units: a `systemctl stop` makes them vanish (a later start finds
    # nothing), so their lifecycle goes through the orchestrator -- kill_node WITHOUT purge (keeps
    # config + ILK) / start_node.
    held = hold_down(["sy-storage.service", "sy-frontdesk-gov.service"])
    ai_nodes = [n for n in sorted(base) if n.startswith("AI.")]
    for n in ai_nodes:
        status, resp = api("DELETE", "/hives/%s/nodes/%s" % (q(hive_id), q(n)),
                           {"force": False, "purge_instance": False}, timeout=120)
        if not ok(status, resp):
            print("  WARN could not stop %s (%s): %s" % (n, status, str(resp)[:160]))
    try:
        tables = storage_tables()
        if tables:
            psql("TRUNCATE %s RESTART IDENTITY CASCADE" % ", ".join('"%s"' % t for t in tables))
        for p in conversation_dirs():
            rm_path(p)
    finally:
        release(held)
        for n in ai_nodes:
            status, resp = api("POST", "/hives/%s/nodes/%s/start" % (q(hive_id), q(n)), {}, timeout=120)
            if not ok(status, resp):
                print("  WARN could not start %s (%s): %s" % (n, status, str(resp)[:160]))
    left = {t: c for t, c in storage_counts(storage_tables()).items() if c}
    print("  %d tables truncated%s; %d conversation dirs removed"
          % (len(tables), (" -- NOT EMPTY: %s" % left) if left else "", len(conv)))
    status, resp = api("DELETE", "/api/sessions", host=ARCHITECT)
    print("  Architect sessions: %s" % ("cleared" if 200 <= status < 300 else "FAIL %s %s" % (status, str(resp)[:160])))

    print("== [8/8] verify")
    for _ in range(40):
        hives = list_hives()
        if all(st in ("alive", "connected") for _, st in hives):
            break
        time.sleep(3)
    failed_units = sh(["systemctl", "--failed", "--no-legend", "--plain"], check=False).stdout.split()
    print("  hives: %s" % ", ".join("%s=%s" % h for h in hives))
    print("  failed units: %s" % (" ".join(u for u in failed_units if u.endswith(".service")) or "none"))
    problems = (len(wf_fail) + len(node_fail) + len(page_fail) + len(ilk_fail) + len(vault_fail) + len(tenant_fail)
                + len(opa_fail) + len(left) + len(cog_fail))
    summary = "%s factory-reset hive=%s workflows=%d nodes=%d pages=%d ilks=%d secrets=%d tables=%d problems=%d (%.0fs)" % (
        time.strftime("%Y-%m-%dT%H:%M:%S%z"), hive_id, len(workflows), len(user_nodes), pages_done, len(ilks_now),
        len(secrets_now), len(tables), problems, time.time() - t0)
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a") as f:
            f.write(summary + "\n")
    except OSError:
        pass
    print("\n" + summary)
    if problems:
        print("Some steps failed (see above). Re-running is safe: every step only removes what is still there.")
        return 1
    print("Done. AI nodes stay degraded until a provider key is loaded again (see fluxbee-firstboot's hint).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
