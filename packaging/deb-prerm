#!/bin/sh
# fluxbee .deb prerm: stop + disable services before removal.
set -e
if [ -d /run/systemd/system ]; then
    for s in sy-orchestrator sy-edge sy-frontdesk-gov sy-wf-rules sy-timer sy-policy \
             sy-cognition sy-identity sy-storage sy-vault sy-architect sy-admin \
             sy-opa-rules sy-config-routes rt-gateway; do
        systemctl stop "$s.service" >/dev/null 2>&1 || true
    done
    systemctl disable sy-orchestrator.service >/dev/null 2>&1 || true
fi
exit 0
