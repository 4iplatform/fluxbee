#!/bin/sh
# fluxbee .deb postinst: system user, dirs, units. A fresh install does NOT start
# services: `fluxbee-firstboot` owns that transition after provisioning secrets.
# During an upgrade, prerm stopped the old processes, so start the orchestrator
# and the motherbee singleton nodes again after the new binaries and units are installed.
set -e

if ! getent passwd fluxbee >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/fluxbee --no-create-home \
        --shell /usr/sbin/nologin fluxbee >/dev/null 2>&1 || true
fi

install -d /etc/fluxbee
install -d -m 0700 /var/lib/fluxbee/ssh
install -d -m 0700 /var/lib/fluxbee/tls
for d in state/nodes state/cookbook state/sy-admin state/sy-edge hives opa/current opa/staged opa/backup \
         wf-rules modules blob blob/public state/io-blob syncthing nats \
         dist/runtimes dist/vendor; do
    install -d "/var/lib/fluxbee/$d"
done

# U-3: register this package's base runtimes into the LIVE dist manifest (merge, never replace).
# Runs BEFORE the chown below so ownership covers what it writes, and BEFORE any service starts
# so the orchestrator never observes a manifest without its base runtimes. There is no race:
# the old prerm already stopped every unit, so nothing can read or write the manifest right now.
# dpkg just replaced the core binaries in /usr/bin, so any core-installed.json left over from a
# mesh `update` or a `core_rollback` now describes a build that is no longer there. Drop it:
# absent means "whatever dist says", which is exactly true right after a package install, and a
# stale record would make /versions report drift that does not exist (versions_comparison
# deliberately prefers `installed` over the dist hash).
rm -f /var/lib/fluxbee/orchestrator/core-installed.json

seed_rc=0
if [ -x /usr/share/fluxbee/fluxbee-seed-runtimes ]; then
    /usr/share/fluxbee/fluxbee-seed-runtimes || seed_rc=$?
else
    echo "fluxbee: ERROR /usr/share/fluxbee/fluxbee-seed-runtimes missing; base runtimes are NOT registered" >&2
    seed_rc=1
fi

install -d /run/fluxbee/routers
chown -R fluxbee:fluxbee \
    /var/lib/fluxbee/syncthing \
    /var/lib/fluxbee/blob \
    /var/lib/fluxbee/dist 2>/dev/null || true

# Seed a config if none exists yet (the operator edits this before first-boot).
if [ ! -f /etc/fluxbee/hive.yaml ] && [ -f /etc/fluxbee/hive.yaml.example ]; then
    cp /etc/fluxbee/hive.yaml.example /etc/fluxbee/hive.yaml
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable sy-orchestrator.service >/dev/null 2>&1 || true
    # IO.cloud and IO.blob are managed runtimes now (no systemd unit): the orchestrator spawns
    # them from their config.json. A FRESH install spawns them via fluxbee-firstboot's
    # boot_runtimes; an EXISTING-hive upgrade must run_node them once (they have no config.json
    # yet, so bootstrap_local's reconcile won't relaunch them) — that one-time migration is an
    # operator step, same as adding any new boot=true runtime to a running hive.
    if [ -n "${2:-}" ]; then
        systemctl start sy-orchestrator.service >/dev/null 2>&1 || true
    fi
fi

echo "fluxbee installed. Edit /etc/fluxbee/hive.yaml, then run:  sudo fluxbee-firstboot"

# Report the seed failure LAST. The box must still come up (never leave it half-installed and
# stopped), so the services above were enabled and started regardless; exiting non-zero here
# makes `dpkg --configure -a` retry the idempotent seed.
if [ "$seed_rc" -ne 0 ]; then
    echo "fluxbee: base runtime registration FAILED — base nodes will report RUNTIME_NOT_AVAILABLE." >&2
    echo "  repair:  sudo fluxbee-seed-runtimes && sudo systemctl restart sy-orchestrator" >&2
    echo "  or:      sudo dpkg --configure -a" >&2
    exit "$seed_rc"
fi

exit 0
