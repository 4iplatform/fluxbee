# IO.blob runs only on the motherbee and accepts worker RPCs only from this SY.admin.
IO_BLOB_ADMIN_HIVE=motherbee

# The active store is managed by the existing BlobToolkit/Syncthing pipeline.
IO_BLOB_BLOB_ROOT=/var/lib/fluxbee/blob
IO_BLOB_PUBLIC_ROOT=/var/lib/fluxbee/blob/public

# Publication ownership/refcounts are local durable state, separate from blob bytes.
IO_BLOB_LEDGER_PATH=/var/lib/fluxbee/state/io-blob/publications.json

# Hard upper bound for one curated artifact (100 MiB).
IO_BLOB_MAX_BYTES=104857600
