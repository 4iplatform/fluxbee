#!/usr/bin/env bash
# Fluxbee first-boot orchestration (idempotent). The orchestrator can't stabilize
# until the postgres secret is in the vault, but the vault needs the orchestrator
# up to receive it (Model D' chicken-egg). This script: bootstraps postgres,
# starts the orchestrator (it crash-loops), waits for the admin API, vault_puts
# the postgres secret, and waits for the hive to go ready.
#
#   sudo fluxbee-firstboot
# Env: FLUXBEE_DB_USER/FLUXBEE_DB_PASSWORD (default fluxbee/fluxbee),
#      FLUXBEE_ADMIN (default 127.0.0.1:8080).
set -uo pipefail
ADMIN="${FLUXBEE_ADMIN:-127.0.0.1:8080}"
PG_USER="${FLUXBEE_DB_USER:-fluxbee}"
PG_PASS="${FLUXBEE_DB_PASSWORD:-fluxbee}"
PG_URL="postgresql://${PG_USER}:${PG_PASS}@127.0.0.1:5432"
ROOT_TENANT="tnt:00000000-0000-0000-0000-000000000001"
HIVE_ID="$(awk -F': ' '/^hive_id:/{gsub(/"/,"",$2);print $2;exit}' /etc/fluxbee/hive.yaml 2>/dev/null || echo motherbee)"
# Declarative base-node set (packaging/base-nodes.json, installed by the .deb). Drives which
# singletons to start and which runtimes to auto-spawn at boot — keeps this in lock-step with
# build-deb.sh. mf() reads a view; falls back to the hardcoded singletons if the file is absent.
MANIFEST="${FLUXBEE_BASE_NODES:-/usr/share/fluxbee/base-nodes.json}"
mf() { # singleton_units -> unit names ; boot_runtimes -> "<runtime>\t<instance>" for boot=true
  [ -f "$MANIFEST" ] || return 0
  python3 - "$MANIFEST" "$1" <<'PY' 2>/dev/null || true
import json, sys
m = json.load(open(sys.argv[1])); what = sys.argv[2]
if what == "singleton_units":
    for e in m.get("singletons", []):
        print(e.get("unit") or e["node"])
elif what == "boot_runtimes":
    for e in m.get("runtimes", []):
        if e.get("boot"):
            print("%s\t%s" % (e.get("runtime", ""), e.get("instance", "")))
PY
}

wait_hive_ready() {
  local attempts="${1:-60}"
  local r=""
  for _ in $(seq 1 "$attempts"); do
    r="$(curl -s -m3 "$ADMIN/hives" 2>/dev/null || true)"
    case "$r" in *'"status":"ok"'*) echo "  HIVE READY"; return 0;; esac
    sleep 2
  done
  return 1
}

echo "== [1/5] postgresql + DB bootstrap =="
systemctl enable --now postgresql 2>/dev/null \
  || pg_ctlcluster "$(ls /usr/lib/postgresql/ 2>/dev/null | head -1)" main start 2>/dev/null || true
sleep 2
sudo -u postgres psql -v ON_ERROR_STOP=0 >/dev/null 2>&1 <<SQL || true
DO \$\$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname='${PG_USER}') THEN CREATE ROLE ${PG_USER} LOGIN PASSWORD '${PG_PASS}'; END IF; END \$\$;
SQL
for db in fluxbee fluxbee_identity fluxbee_storage; do
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='${db}'" 2>/dev/null | grep -q 1 \
    || sudo -u postgres createdb -O "${PG_USER}" "${db}" 2>/dev/null || true
done

echo "== [2/5] start orchestrator (crash-loops until the secret lands) =="
systemctl reset-failed sy-orchestrator 2>/dev/null || true
systemctl restart sy-orchestrator

echo "== [3/5] wait admin + vault_put postgres secret =="
for _ in $(seq 1 60); do curl -s -m3 "$ADMIN/hives" >/dev/null 2>&1 && break; sleep 2; done
body="{\"key\":\"storage_postgres_url\",\"value\":{\"postgres_url\":\"$PG_URL\"},\"metadata\":{\"tenant_id\":\"$ROOT_TENANT\",\"resource_type\":\"postgres\"}}"
vault_ok=0
for _ in $(seq 1 20); do
  r="$(curl -s -m10 -X POST "$ADMIN/hives/$HIVE_ID/vault/secrets" -H 'content-type: application/json' -d "$body" 2>/dev/null || true)"
  case "$r" in *'"status":"ok"'*) echo "  vault_put OK"; vault_ok=1; break;; *) sleep 3;; esac
done
if [ "$vault_ok" != 1 ]; then
  # Do NOT echo $body (it carries the postgres URL); the response $r is safe (no secret).
  echo "ERROR: vault_put storage_postgres_url failed after 20 tries — postgres secret NOT stored." >&2
  echo "       DB consumers (storage/identity) will stay 'not initialized' and the hive will not become ready." >&2
  echo "       Last admin response: ${r:-<no response / admin unreachable>}" >&2
  exit 1
fi

# The DB consumers (storage/identity) connect to postgres at startup; if they
# came up before the secret was in the vault they stay "not initialized". The
# secret is now persisted in vault.db, so restart vault FIRST (it comes up
# holding the secret), THEN the consumers — each PULLS the secret from the live
# vault on startup. This startup pull is robust because it doesn't depend on
# broadcast timing (the VAULT_SECRET_CHANGED broadcast still drives runtime
# secret changes; here we just want the consumers to acquire the existing one).
# Finally re-kick the orchestrator so its sy-storage readiness gate passes.
echo "== [4/5] reconnect DB consumers (vault up first, consumers pull the secret) =="
HIVE_READY=0
for attempt in $(seq 1 6); do
  systemctl restart sy-vault 2>/dev/null || true
  sleep 4
  systemctl restart sy-storage sy-identity 2>/dev/null || true
  sleep 4
  systemctl reset-failed sy-orchestrator 2>/dev/null || true
  systemctl restart sy-orchestrator 2>/dev/null || true
  if wait_hive_ready 10; then
    HIVE_READY=1
    break
  fi
  echo "  DB reconnect attempt $attempt did not reach hive ready; retrying"
done

echo "== [5/6] wait hive ready + start motherbee singleton nodes =="
if [ "$HIVE_READY" != "1" ] && wait_hive_ready 60; then
  HIVE_READY=1
fi
echo -n "services: "; systemctl is-active rt-gateway sy-orchestrator sy-identity sy-admin sy-vault sy-storage sy-architect 2>&1 | tr '\n' ' '; echo
if [ "$HIVE_READY" != "1" ]; then
  echo "first-boot failed: hive did not become ready." >&2
  exit 1
fi
# IO.blob and IO.cloud are no longer systemd singletons: they are boot=true managed runtimes,
# spawned below by the same boot_runtimes loop as io.api/io.slack/ai.chat (they come up degraded
# until configured via CONFIG_SET). Nothing to start here anymore.

echo "== [6/6] spawn base node instances (running, degraded until configured) =="
# Auto-spawn one default instance of each boot=true runtime at the root tenant. They come up
# RUNNING but degraded/unconfigured (no secret/config yet) — deliberate, so a fresh backend has
# basic nodes alive out of the box; the operator loads secrets into SY.vault to make them work.
while IFS=$'\t' read -r rt inst; do
  [ -n "$rt" ] && [ -n "$inst" ] || continue
  body="{\"node_name\":\"$inst\",\"runtime\":\"$rt\",\"runtime_version\":\"current\",\"tenant_id\":\"$ROOT_TENANT\"}"
  r="$(curl -s -m20 -X POST "$ADMIN/hives/$HIVE_ID/nodes" -H 'content-type: application/json' -d "$body" 2>/dev/null || true)"
  case "$r" in
    *'"status":"ok"'*) echo "  spawned $inst ($rt)" ;;
    *) echo "  WARN could not spawn $inst ($rt): ${r:0:140}" ;;
  esac
done < <(mf boot_runtimes)

cat <<EOF

============================================================
 Fluxbee backend is UP. Core (SY.*) + base nodes are RUNNING.
 Some nodes are DEGRADED until you load their secret into SY.vault:

  - AI (ai.generic / architect / admin / cognition) needs a provider key.
    Load an OpenAI (or "anthropic") key:
      curl -sS -X POST $ADMIN/hives/$HIVE_ID/vault/secrets -H 'content-type: application/json' \\
        -d '{"key":"openai_root_pool","value":{"api_key":"sk-..."},"metadata":{"tenant_id":"$ROOT_TENANT","resource_type":"openai"}}'
    NOTE: the default provider is 'openai'. For an Anthropic key (resource_type "anthropic"),
    also set 'ai.default_provider: anthropic' in /etc/fluxbee/hive.yaml and restart the AI nodes,
    or the AI nodes keep resolving the openai pool and stay degraded.

  - IO.slack needs its tokens (resource_type "slack", value {app_token, bot_token}).

  - IO.wapp (WhatsApp Cloud API) needs its secret (resource_type "whatsapp",
    value {access_token, app_secret, verify_token}) AND the public webhook wired
    as a fanout: externalize ONE edge endpoint for the Meta app with the family
    glob "IO.wapp.*@$HIVE_ID" and the app-level verify_token, then set each node's
    io.phone_number_id via CONFIG_SET. One IO.wapp.<label> node per number.

  Any other node secret is loaded into SY.vault the same way (POST .../vault/secrets).

 Architect (Archi): http://<this-host>:3000    Admin API: $ADMIN
============================================================
EOF
echo "first-boot done."
