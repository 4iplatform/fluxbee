hive_id: "motherbee"
role: motherbee

# Hive-wide AI engine used by SY.* consumers, and by every AI node (ai.generic)
# that names no provider or model of its own: such a node takes the model listed
# here for its provider. Credentials remain in SY.vault under the selected
# provider's resource_type (openai or anthropic).
ai:
  default_provider: openai
  providers:
    openai:
      model: "gpt-5.5"
    # anthropic:
    #   model: "claude-sonnet-5-5"

# WAN / inter-hive gateway. A root motherbee has no uplink (workers/egress
# connect TO it). `wan.mtls` controls inter-hive transport auth:
#   disabled   - plaintext WAN (what the code assumes when the key is absent)
#   permissive - use mTLS when both peers present a cert, accept plaintext (WARN)
#   required   - reject any peer without a valid mesh cert (fail-closed)
# The installer provisions the mesh CA + this hive's cert under
# /var/lib/fluxbee/tls/<hive_id> regardless of mode, so flipping the mode is
# instant. This file ships "required", and add_hive writes "required" for every hive it joins
# (distributing its cert): a hive on "required" rejects any plaintext join.
wan:
  listen: "0.0.0.0:9000"
  gateway_name: "RT.gateway"
  mtls: required

# Local admin HTTP API.
admin:
  listen: "127.0.0.1:8080"
  # The SY.edge this hive publishes public artifacts / Cloud endpoints on.
  # public_edge_node: "SY.edge@<ingress-hive>"
  # Absolute public origin for /public/<key> URLs and the base external clients use.
  # MUST be a DNS HOSTNAME that the edge TLS cert covers (e.g. this hive's opaque
  # hive-<hash>.<domain> name), NEVER a bare IP — an IP fails cert validation and TLS
  # aborts (handshake eof) for any client that verifies the cert. One per hive. With an
  # `acme:` section below, its host is also the name SY.admin certifies.
  # public_base_url: "https://hive-<hash>.example.com"

# The edge's certificate from an ACME CA (Let's Encrypt by default), issued and renewed by
# SY.admin with the TLS-ALPN-01 challenge on the edge's :443 (docs/acme-edge-certificates-v1.md).
# Needs public_edge_node and public_base_url above, the name's DNS pointing at the ingress, and
# :443 reachable from the whole internet. Without this section the edge serves a certificate
# seeded by hand (see `edge:` below) and SY.admin only watches its expiry. Read GET /acme/status.
# acme:
#   terms_agreed: true          # required: you accept the CA's terms of service
#   directory_url: "https://acme-v02.api.letsencrypt.org/directory"                 # default
#   staging_directory_url: "https://acme-staging-v02.api.letsencrypt.org/directory" # default
#   profile: "classic"          # optional; the CA's default when absent
#   contact: "mailto:ops@example.com"   # optional
#   trust_anchor: "/etc/fluxbee/acme-ca.pem"   # only for a private CA

# The web hosts: names the public edge serves only through io.web, never /e/ or /public/
# (docs/io-web-v2.md §11). Each is a label before the host of public_base_url: `archi: true`
# declares archi.<that host>, Archi's own host. It needs one key set; a bare `web:` declares
# nothing. SY.admin reads it at boot and pushes the routes to public_edge_node every minute.
# Make the host's DNS record by hand, pointing at the ingress like the main name. With `acme:`,
# the certificate carries the host too, after explicit steps: restart SY.admin,
# POST /acme/test, then POST /acme/renew. Until then name_not_covered alerts. Removing the host
# takes its route off the edge after the restart, and its name off the certificate at the next
# renewal.
# web:
#   archi: true

# Archi's HTTP UI/API. Loopback only: it has no authentication (FINDINGS A-46). Use it on the
# motherbee itself, or from another machine through an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 <user>@<motherbee>
architect:
  listen: "127.0.0.1:3000"

# Shared filesystem root used by admin/orchestrator.
storage:
  path: "/var/lib/fluxbee"

# Identity runtime settings.
identity:
  sync:
    port: 9100
    # Per-hive HMAC peer-auth on the :9100 inter-hive channel: disabled | required.
    # The motherbee generates each hive's key and distributes it at add_hive.
    auth: required

# Government/frontdesk wiring.
government:
  identity_frontdesk: "SY.frontdesk.gov@motherbee"

# Blob runtime config.
blob:
  enabled: true
  path: "/var/lib/fluxbee/blob"
  sync:
    enabled: true
    # Dedicated one-way public artifact channel: motherbee sends, ingress receives.
    public_enabled: true
    tool: "syncthing"
    api_port: 8384
    data_dir: "/var/lib/fluxbee/syncthing"

# Runtime artifact distribution config.
dist:
  path: "/var/lib/fluxbee/dist"
  sync:
    enabled: true
    tool: "syncthing"

# Declarative packaged platform topology per hive role. `nodes` is the start order;
# `wait_for` is the subset the orchestrator blocks on before continuing
# bootstrap. Only SY.* system authorities are listed here; the managed IO/AI
# runtimes (io.api, io.blob, io.cloud, io.slack, ai.generic, ...) are NOT lifecycle
# nodes — the orchestrator spawns them via run_node (fluxbee-firstboot boot_runtimes)
# after the hive is ready. Identity seeds deterministic ILKs only for the SY.* entries.
# Workers do not run SY.vault.
system_nodes:
  motherbee:
    # Model D' boot order (enforced by sy_orchestrator::validate_system_nodes):
    #   1. SY.config.routes FIRST (writer of /jsr-config-<hive> SHM).
    #   2. All vault consumers SECOND (they register with the router before
    #      vault emits its bootstrap broadcast; each tolerates VAULT_UNAVAILABLE).
    #   3. SY.vault LAST — broadcasts only reach already-registered nodes.
    nodes:
      - SY.config.routes
      - SY.identity
      - SY.opa.rules
      - SY.admin
      - SY.architect
      - SY.storage
      - SY.cognition
      - SY.timer
      - SY.wf-rules
      - SY.frontdesk.gov
      - SY.vault
    wait_for:
      - SY.config.routes
      - SY.identity
      - SY.opa.rules
      - SY.admin
      - SY.cognition
      - SY.timer
      - SY.vault
  worker:
    nodes:
      - SY.config.routes
      - SY.identity
      - SY.opa.rules
      - SY.cognition
      - SY.timer
      - SY.wf-rules
    wait_for:
      - SY.config.routes
      - SY.identity
      - SY.opa.rules
      - SY.cognition
      - SY.timer
  # SY.opa.rules runs on EVERY role: the router of each hive enforces the one global user
  # policy, compiled on the motherbee and synced to all hives (dist/policy). It needs no
  # SY.identity (its ILK is deterministic), and it is not a readiness gate here.
  egress:
    nodes:
      - SY.config.routes
      - SY.opa.rules
    wait_for:
      - SY.config.routes
  # ingress hive: the public HTTP(S) door. SY.edge binds :443 (fail-closed on
  # role==ingress) and reverse-proxies /e/<ich> into the mesh. No SY.identity here
  # (identity frontier) — the edge forwards by pre-resolved owner name (Option Z).
  ingress:
    nodes:
      - SY.config.routes
      - SY.opa.rules
      - SY.edge
    wait_for:
      - SY.config.routes

# --- edge: the public ingress door (only used when role: ingress) ---
# Uncommented on an ingress hive. SY.edge serves the public HTTPS door with the
# certificate it reads from SY.vault under tls_vault_key (never plaintext once a
# certificate is requested). Until the secret exists the edge waits: it answers only
# the ACME challenge and refuses every other connection. With `acme:` on the motherbee,
# SY.admin issues and stores it; by hand, seed it via SY.admin and then reload:
#   POST /hives/<vault_hive>/vault/secrets
#   {key:"edge_tls", value:{cert:"<PEM chain>", key:"<PEM key>"},
#    metadata:{resource_type:"tls", owner_node:"SY.edge@<edge_hive>"}}
#   POST /acme/reload
# owner_node MUST be the edge's fully-qualified name so the dedicated-owner read
# authorizes (the edge has no identity SHM; authz is by its deterministic ilk). The
# name must start with "edge_tls".
# The web hosts (`web:` on the motherbee) go through the edge to io.web on the motherbee: the
# host of this hive's wan.uplinks[0], port 9200, over the mesh's mutual TLS with the material in
# /var/lib/fluxbee/tls/<hive_id> (docs/nodes/sy-edge.md, "The proxy to io.web").
# web_max_inflight caps the requests in flight to io.web, each with its own connection to the
# motherbee until its response ends; one more gets a quick 503 (default 128; 0 turns it off).
# edge:
#   listen: "0.0.0.0:443"
#   tls_vault_key: "edge_tls"
#   vault_hive: "motherbee"
#   endpoints_path: "/etc/fluxbee/edge.endpoints.json"
#   web_max_inflight: 128

# --- ingress (root-level section; only used when role: ingress) -----------------------
# The ingress takes SSH only from loopback, the motherbee (its address in wan.uplinks) and the
# addresses and networks listed here; all other SSH is dropped, IPv4 and IPv6, on the ports
# `sshd -T` reports (table inet fluxbee_ingress, loaded at boot by fluxbee-ingress-nft.service;
# docs/control-path-hardening-v1.md §6). add_hive writes this list from its `ssh_allow_from`
# parameter; the join refuses to start when the motherbee's own SSH would come from an address
# outside the set. Nothing else is filtered. Only a complete input set changes the table: a bad
# entry, an empty set, an uplink that does not resolve or `sshd -T` failing keeps the rules in
# force and raises a posture alert. Recovery: the hypervisor console, or edit this list and
# restart sy-orchestrator.
# ingress:
#   ssh_allow_from:
#     - "192.168.8.0/24"     # an operator network
#     - "fd00:10::5"         # one address

# --- egress (root-level section; NOT the `system_nodes.egress` list above) ------------
# The managed internet chokepoint. `gateway_ip` means, BY CONTRACT, "where the WORKERS
# egress": add_hive injects that default route into workers provisioned AFTER it is set.
#
# It does NOT route motherbee. That is deliberate — Fluxbee never rewrites the control
# plane's own default route (doing it from a yaml field, on every boot and every watchdog
# tick, with no rollback, on the box that provisions the egress, is a lockout). But
# motherbee is where the nodes that call the internet run (IO.slack.*, IO.wapp.*, AI.*),
# so the orchestrator VERIFIES motherbee's route against this value and logs
# EGRESS_MOTHERBEE_BYPASS when they differ. Put motherbee on the egress path at the
# host/network level if you want it there — or accept the bypass knowingly (PB-8).
#
# egress:
#   enabled: true
#   gateway_ip: "10.10.10.40"     # the egress hive's LAN address
#   lan_cidr: "10.10.10.0/24"
#   lan_iface: "ens19"            # the egress box's INTERNAL nic
#   wan_iface: "ens18"            # the egress box's UPLINK nic
#   ipv6: "blocked"
#   reachability_url: "https://example.com"   # the https URL the internet probe GETs; no default:
#                                             # without it the probe does not run. add_hive copies
#                                             # it into new workers and into an egress whose request names none
#   ssh_from_wan: true            # egress hive only: SSH may arrive on wan_iface (default true, D31).
#                                 # false drops it in the egress' fluxbee_egress table (the ports
#                                 # `sshd -T` reports, else the ones it already drops); add_hive's
#                                 # egress.ssh_from_wan writes it, and refuses a join whose packets
#                                 # would come in on wan_iface
