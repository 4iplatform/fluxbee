    "layer": "design",
    "pattern_key": "multi_hive_with_route",
    "trigger": "User wants a node on a worker hive and a routing rule so messages flow to it from a motherbee agent, the two isolated in their own VPN.",
    "inputs_signature": {
      "source_hive": "motherbee",
      "target_hive": "worker-*",
      "need_vpn": true,
      "need_route": true
    },
    "successful_shape": {
      "desired_state": {
        "topology": {
          "hives": [
            { "hive_id": "worker-220", "role": "worker", "ownership": "solution" }
          ],
          "vpns": [
            { "hive": "motherbee", "pattern": "AI.frontline", "match_kind": "PREFIX", "vpn_id": 220, "ownership": "solution" },
            { "hive": "worker-220", "pattern": "AI.specialist", "match_kind": "PREFIX", "vpn_id": 220, "ownership": "solution" }
          ]
        },
        "nodes": [
          {
            "node_name": "AI.specialist@worker-220",
            "hive": "worker-220",
            "runtime": "ai.generic",
            "config": {},
            "ownership": "solution"
          }
        ],
        "routing": [
          {
            "hive": "motherbee",
            "prefix": "AI.specialist.",
            "action": "FORWARD",
            "next_hop_hive": "worker-220",
            "ownership": "solution"
          }
        ]
      }
    },
    "constraints": [
      "a VPN rule is SY.config.routes' rule: hive, pattern, match_kind (EXACT, PREFIX or GLOB) and a numeric vpn_id; it puts the nodes of that hive whose names match into that VPN",
      "nodes reach only nodes of their own VPN (system nodes excepted): give the specialist and the motherbee agent that calls it the same vpn_id",
      "route prefix must end with a dot (e.g., 'AI.specialist.' not 'AI.specialist')",
      "next_hop_hive in routing must match the hive_id of the target hive exactly"
    ],
    "do_not_repeat": [
      "do not add topology.hives for motherbee — it always exists",
      "do not declare a VPN rule unless the request asks to isolate nodes: a node left out of it can no longer reach the nodes in it",
      "do not set next_hop_hive to a hive where the node does not live"
    ],
